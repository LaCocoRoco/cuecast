# Virtuelle Umgebung - nicht portabel zwischen Rechnern, wird von run.bat neu erzeugt.
.venv/

# Python-Bytecode-Cache
__pycache__/
*.pyc

# Temporäre Datei für die Play/Pause-Vorschau im Trigger Editor
_preview.wav

# Eigene Audio-Aufnahmen (echte Spiel-Sounds) - bei einem oeffentlichen Repo bewusst nicht
# mit hochgeladen (Copyright). Beim Wechsel auf einen anderen Rechner manuell mitkopieren.
snippets/*.wav

# Persoenliche Einstellungen - je Nutzer/Rechner unterschiedlich, wird von settings.py
# automatisch mit sinnvollen Defaults neu angelegt, falls nicht vorhanden.
settings.json
